// Debug configuration for AretaCare
// Local development settings

#include? "Secrets.xcconfig"

// API_BASE_URL and FRONTEND_URL default to localhost in code.
// Override in Secrets.xcconfig for staging/remote servers.
API_BASE_URL = https:/$()/api.aretacare.com/api
FRONTEND_URL = https:/$()/www.aretacare.com
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
GCC_OPTIMIZATION_LEVEL = 0
ENABLE_TESTABILITY = YES
