# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/aretacare
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=aretacare

# OpenAI Configuration
OPENAI_API_KEY=
# Optional: Override default timeouts/retries
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=3
# OPENAI_RETRY_DELAY=1
# OPENAI_MAX_RETRY_DELAY=16

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_KEY_PREFIX=dev/  # Use "dev/" or "prod/" to separate environments in shared bucket

# Application Configuration
SECRET_KEY=your_secret_key_here_min_32_chars_change_in_production
DEBUG=True
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Email Configuration (for password reset, notifications, and feedback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=  # Gmail App Password
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AretaCare
FRONTEND_URL=http://localhost:3001

# Feedback System
FEEDBACK_EMAIL=feedback@yourdomain.com

# Security Alerts
# Email address to receive security alerts
SECURITY_ALERT_EMAIL=security@yourdomain.com
# Comma-separated event types that trigger alerts (leave empty to disable)
# Available: account_lockout, blocked_file_upload, email_changed, unauthorized_access, failed_login, mfa_login_failed
SECURITY_ALERT_EVENTS=account_lockout,blocked_file_upload,email_changed,unauthorized_access

# Admin Configuration
ADMIN_EMAILS=  # Comma-separated list of admin email addresses
CONTROL_SIGNUPS=True  # When True, registration requires waitlist invitation

# Log Retention (in days)
AUDIT_LOG_RETENTION_DAYS=90
ERROR_LOG_RETENTION_DAYS=30
API_LOG_RETENTION_DAYS=30
SECURITY_LOG_RETENTION_DAYS=90
ADMIN_REPORT_RETENTION_DAYS=30

# hCaptcha Configuration (for spam prevention on feedback form)
# For localhost development, leave empty to skip verification
# For production, get keys from https://www.hcaptcha.com/
HCAPTCHA_SECRET_KEY=

# WebAuthn (Passkey) Configuration
# For localhost development, use defaults
# For production, set to your domain (e.g., "aretacare.com" and "https://aretacare.com")
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
