# API Configuration
# Only needed if backend is not at /api relative to frontend
VITE_API_URL=http://localhost:8000/api

# hCaptcha Configuration (for spam prevention on feedback form)
# For localhost development, use test key: 10000000-ffff-ffff-ffff-000000000001
# For production, get your site key from https://www.hcaptcha.com/
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# Sentry Error Monitoring
# Leave empty to disable Sentry entirely (recommended for local dev)
VITE_SENTRY_DSN=
